<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CSharp2CUDA</AssemblyName>
    <RootNamespace>CSharp2CUDA</RootNamespace>
    <PackageId>CSharp2CUDA</PackageId>
    <Description>Strict Roslyn-based C# to CUDA source transpilation.</Description>
    <Authors>Supprocom</Authors>
    <RepositoryUrl>https://github.com/Supprocom/CSharp2CUDA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
