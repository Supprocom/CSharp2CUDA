<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Supprocom.CSharp2CUDA</AssemblyName>
    <RootNamespace>Supprocom.CSharp2CUDA</RootNamespace>
    <PackageId>Supprocom.CSharp2CUDA</PackageId>
    <Description>Translate selected regular C# static methods into deterministic CUDA C++.</Description>
    <PackageDescription>Roslyn-based translation for selectively accelerating portable C# algorithms with CUDA.</PackageDescription>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Supprocom/CSharp2CUDA</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Supprocom/CSharp2CUDA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cuda;csharp;roslyn;transpiler;source-translation;gpu</PackageTags>
    <PackageReleaseNotes>Broaden the portable C# profile with ranges and Span operations, fixed local collections and params, operators, patterns, tuples, nonescaping captures, references, positional readonly record structs, and additional scalar framework mappings.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\docs\getting-started.md" Pack="true" PackagePath="docs\getting-started.md" />
    <None Include="..\docs\portable-csharp.md" Pack="true" PackagePath="docs\portable-csharp.md" />
    <None Include="..\docs\cuda-interop.md" Pack="true" PackagePath="docs\cuda-interop.md" />
    <None Include="..\docs\tool.md" Pack="true" PackagePath="docs\tool.md" />
    <None Include="..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="build\Supprocom.CSharp2CUDA.targets"
          Pack="true"
          PackagePath="build\Supprocom.CSharp2CUDA.targets" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
    <InternalsVisibleTo Include="Supprocom.CSharp2CUDA.Build" />
    <InternalsVisibleTo Include="Supprocom.CSharp2CUDA.Compiler" />
    <InternalsVisibleTo Include="Supprocom.CSharp2CUDA.Tool" />
    <InternalsVisibleTo Include="Supprocom.CSharp2CUDA.Tests" />
  </ItemGroup>

  <Target Name="ValidatePackageProvenance" BeforeTargets="_IntermediatePack">
    <Error Condition="'$(RepositoryCommit)' == ''" Text="RepositoryCommit is required for package creation." />
    <Error Condition="'$(RepositoryBranch)' == ''" Text="RepositoryBranch is required for package creation." />
  </Target>

  <Target Name="BuildPackageTools" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Supprocom.CSharp2CUDA.Build\Supprocom.CSharp2CUDA.Build.csproj"
             Targets="Build"
             BuildInParallel="false"
             Condition="'$(NoBuild)' != 'true'"
             Properties="Configuration=$(Configuration);BuildProjectReferences=false;Version=$(Version);PackageVersion=$(PackageVersion);RepositoryCommit=$(RepositoryCommit);RepositoryBranch=$(RepositoryBranch);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)">
      <Output TaskParameter="TargetOutputs" ItemName="_CudaBuildAssembly" />
    </MSBuild>
    <MSBuild Projects="..\Supprocom.CSharp2CUDA.Compiler\Supprocom.CSharp2CUDA.Compiler.csproj"
             Targets="Build"
             BuildInParallel="false"
             Condition="'$(NoBuild)' != 'true'"
             Properties="Configuration=$(Configuration);BuildProjectReferences=false;Version=$(Version);PackageVersion=$(PackageVersion);RepositoryCommit=$(RepositoryCommit);RepositoryBranch=$(RepositoryBranch);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)">
      <Output TaskParameter="TargetOutputs" ItemName="_CudaCompilerAssembly" />
    </MSBuild>
    <ItemGroup>
      <_CudaBuildPdb Include="@(_CudaBuildAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <_CudaCompilerPdb Include="@(_CudaCompilerAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <_CudaBuildCodeAnalysis Include="@(_CudaBuildAssembly->'%(RootDir)%(Directory)Microsoft.CodeAnalysis.dll')" />
      <_CudaBuildCodeAnalysisCSharp Include="@(_CudaBuildAssembly->'%(RootDir)%(Directory)Microsoft.CodeAnalysis.CSharp.dll')" />
      <None Include="@(_CudaBuildAssembly)"
            Pack="true"
            PackagePath="build\task\Supprocom.CSharp2CUDA.Build.dll" />
      <None Include="@(_CudaBuildPdb)"
            Pack="true"
            PackagePath="build\task\Supprocom.CSharp2CUDA.Build.pdb" />
      <None Include="$(TargetPath)"
            Pack="true"
            PackagePath="build\task\Supprocom.CSharp2CUDA.dll" />
      <None Include="@(_CudaBuildCodeAnalysis)"
            Pack="true"
            PackagePath="build\task\Microsoft.CodeAnalysis.dll" />
      <None Include="@(_CudaBuildCodeAnalysisCSharp)"
            Pack="true"
            PackagePath="build\task\Microsoft.CodeAnalysis.CSharp.dll" />
      <None Include="$(TargetPath)"
            Pack="true"
            PackagePath="build\compiler\Supprocom.CSharp2CUDA.dll" />
      <None Include="@(_CudaCompilerAssembly)"
            Pack="true"
            PackagePath="build\compiler\Supprocom.CSharp2CUDA.Compiler.dll" />
      <None Include="@(_CudaCompilerPdb)"
            Pack="true"
            PackagePath="build\compiler\Supprocom.CSharp2CUDA.Compiler.pdb" />
    </ItemGroup>
  </Target>
</Project>
