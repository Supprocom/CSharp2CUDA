<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Supprocom.CSharp2CUDA</AssemblyName>
    <RootNamespace>Supprocom.CSharp2CUDA</RootNamespace>
    <PackageId>Supprocom.CSharp2CUDA</PackageId>
    <Description>Strict Roslyn-based C# to CUDA source transpilation.</Description>
    <PackageDescription>Strict Roslyn-based translation from valid C# source to deterministic CUDA C++ source.</PackageDescription>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Supprocom/CSharp2CUDA</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Supprocom/CSharp2CUDA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cuda;csharp;roslyn;transpiler;source-translation;gpu</PackageTags>
    <PackageReleaseNotes>Add the Supprocom.CSharp2CUDA identity, typed CUDA contracts, and read-only validation for device constant arrays.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\docs\getting-started.md" Pack="true" PackagePath="docs\getting-started.md" />
    <None Include="..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
  </ItemGroup>

  <Target Name="ValidatePackageProvenance" BeforeTargets="_IntermediatePack">
    <Error Condition="'$(RepositoryCommit)' == ''" Text="RepositoryCommit is required for package creation." />
    <Error Condition="'$(RepositoryBranch)' == ''" Text="RepositoryBranch is required for package creation." />
  </Target>
</Project>
