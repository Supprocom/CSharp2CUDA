<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.CSharp2CUDA"
                      Version="[$(CSharp2CUDAPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Inputs\*.cs" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures\ExternalDispatchBoundary.cs" />
    <Compile Remove="Fixtures\InvalidVoidInlineArray.cs" />
    <Content Include="Fixtures\ExternalDispatchBoundary.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\InvalidVoidInlineArray.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Fixtures\ExternalDispatchSourceMap.json" />
    <Content Include="Fixtures\ExternalDispatchSourceMap.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
