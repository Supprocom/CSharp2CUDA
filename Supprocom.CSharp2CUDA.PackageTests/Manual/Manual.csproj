<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.CSharp2CUDA" Version="[0.2.1]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Inputs\*.cs" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures\MtsRemainingBoundary.cs" />
    <Compile Remove="Fixtures\InvalidVoidInlineArray.cs" />
    <Content Include="Fixtures\MtsRemainingBoundary.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\InvalidVoidInlineArray.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Fixtures\MtsBoundarySourceMap.json" />
    <Content Include="Fixtures\MtsBoundarySourceMap.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
