<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TranspileToCUDA>true</TranspileToCUDA>
    <TranspileToCUDAOutputPath>../Escape.cu</TranspileToCUDAOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.CSharp2CUDA"
                      Version="[$(CSharp2CUDAPackageVersion)]" />
  </ItemGroup>
</Project>
