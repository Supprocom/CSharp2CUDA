<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TranspileToCUDA>true</TranspileToCUDA>
    <TranspileToCUDAOutputPath>cuda/GeneratedProject.cu</TranspileToCUDAOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.CSharp2CUDA"
                      Version="[$(CSharp2CUDAPackageVersion)]" />
    <Analyzer Include="$(CSharp2CUDAGeneratorAssembly)" />
  </ItemGroup>
</Project>
