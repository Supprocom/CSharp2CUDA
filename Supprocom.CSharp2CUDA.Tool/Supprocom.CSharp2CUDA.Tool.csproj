<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Supprocom.CSharp2CUDA.Tool</AssemblyName>
    <RootNamespace>Supprocom.CSharp2CUDA.Tool</RootNamespace>
    <PackageId>Supprocom.CSharp2CUDA.Tool</PackageId>
    <Description>Project compatibility checks and CUDA adapter scaffolding for Supprocom.CSharp2CUDA.</Description>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Supprocom/CSharp2CUDA</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Supprocom/CSharp2CUDA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csharp2cuda</ToolCommandName>
    <PackageTags>cuda;csharp;roslyn;transpiler;scaffold;dotnet-tool</PackageTags>
    <PackageReleaseNotes>Add compatibility checks and compile-checked CUDA adapter scaffolding for ordinary C# algorithms.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Supprocom.CSharp2CUDA\Supprocom.CSharp2CUDA.csproj" />
    <PackageReference Include="Microsoft.Build" Version="[17.11.48]"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="[17.11.48]"
                      ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" Version="[1.11.2]" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[5.6.0]" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryCommit"
                      Value="$(RepositoryCommit)"
                      Condition="'$(RepositoryCommit)' != ''" />
    <InternalsVisibleTo Include="Supprocom.CSharp2CUDA.Tool.Tests" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\docs\getting-started.md"
          Pack="true"
          PackagePath="docs\getting-started.md" />
    <None Include="..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
    <None Include="..\THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <Target Name="ValidatePackageProvenance" BeforeTargets="_IntermediatePack">
    <Error Condition="'$(RepositoryCommit)' == ''" Text="RepositoryCommit is required for package creation." />
    <Error Condition="'$(RepositoryBranch)' == ''" Text="RepositoryBranch is required for package creation." />
  </Target>
</Project>
